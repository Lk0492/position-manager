[Unit]
Description=Position Manager static web service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
Environment=NODE_ENV=production
Environment=PORT=4178
Environment=STATIC_ROOT=/var/www/position-manager/current
ExecStart=/usr/bin/node /opt/position-manager/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
